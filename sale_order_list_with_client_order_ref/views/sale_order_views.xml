<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Add client_order_ref field to Sales > Orders > Quotations -->
    <record id="view_quotation_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="client_order_ref" optional="show" groups="sales_team.group_sale_salesman" />
            </xpath>
        </field>
    </record>

    <!--  Add client_order_ref field to :
            - Sales > Orders > Orders
            - Sales > To Invoice > Orders to Invoice
            - Sales > To Invoice > Orders to Upsell
    -->
    <record id="view_sale_order_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="client_order_ref" optional="show" groups="sales_team.group_sale_salesman" />
            </xpath>
        </field>
    </record>

</odoo>
