<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_inherited_form_purchase" model="ir.ui.view">
            <field name="name">sale.order.inherited.form.purchase</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']//form//div[@name='invoice_lines']" position="after">
                    <div name="purchase_line_ids">
                        <label for="purchase_line_ids"/>
                        <field name="purchase_line_ids"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>