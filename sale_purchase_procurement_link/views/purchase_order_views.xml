<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <record id="purchase_order_inherited_form_sale" model="ir.ui.view">
        <field name="name">purchase.order.inherited.form.sale</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_qty']" position="before">
                <field name="sale_line_id" optional="hide"/>
                <field name="sale_order_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form//field[@name='date_planned']" position="after">
                <field name="sale_line_id" invisible="1"/>
                <field name="sale_order_id"/>
            </xpath>
        </field>
    </record>
</data></odoo>
