<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_team_members_reminder" model="mail.template">
        <field name="name">Team Members Notification</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Opportunity still in draft</field>
        <field name="body_html"><![CDATA[
            <p>Hello ,</p>
            <p>Thank you for following up on this opportunity:<a href="/web#id=${object.id}&amp;model=crm.lead&amp;view_type=form">${object.name}</a></p>
            <p>Sincerely.</p>
        ]]></field>
    </record>
</odoo>