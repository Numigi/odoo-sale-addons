<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--   new team added Technical Support -->
        <record model="crm.team" id="technical_support_team">
            <field name="name">Technical Support</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        <!-- The team is already existed -->
        <record model="crm.team" id="sales_team.team_sales_department" forcecreate="False">
             <field name="name">Sales</field>
             <field name="use_leads">True</field>
             <field name="company_id" ref="base.main_company"/>
        </record>
        <!--   new team added After-Sales Services -->
        <record model="crm.team" id="team_after_sale_service">
            <field name="name">After-Sales Services</field>
            <field name="alias_name">after_sale</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="alias_contact">partners</field>
        </record>
    </data>
</odoo>
