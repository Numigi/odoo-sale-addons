<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_sale_stock_qty" model="ir.ui.view">
        <field name="name">sale.order.line.tree.sale.stock.qty.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock_qty"/>
        <field name="arch" type="xml">
            <!-- Inject required fields for OWL component data access -->
            <xpath expr="//page/field[@name='order_line']/list/field[@name='qty_delivered']" position="after">
                <field name="qty_reserved" column_invisible="True"/>
                <field name="qty_available_color" column_invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>