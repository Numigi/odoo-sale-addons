#. module: numigi_test_crm_rabeb
#: model:mail.template,body_html:numigi_test_crm_rabeb.email_template_stale_opportunity
msgid ""
"<div style=\"font-family: Arial, sans-serif;\">\n"
"                    <p>Hello,</p>\n"
"                    <p>Please follow up on this opportunity\n"
"                        <a href=\"${object.get_base_url()}/web#id=${object.id}&amp;model=crm.lead&amp;view_type=form\" style=\"color: #007bff; text-decoration: none;\">\n"
"                            ${object.name}\n"
"                        </a>.\n"
"                    </p>\n"
"                    <p>Best regards.</p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif;\">\n"
"                    <p>Bonjour,</p>\n"
"                    <p>Merci de donner une suite à cette opportunité\n"
"                        <a href=\"${object.get_base_url()}/web#id=${object.id}&amp;model=crm.lead&amp;view_type=form\" style=\"color: #007bff; text-decoration: none;\">\n"
"                            ${object.name}\n"
"                        </a>.\n"
"                    </p>\n"
"                    <p>Cordialement.</p>\n"
"                </div>\n"
"            "

