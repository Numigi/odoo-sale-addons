<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_stale_opportunity" model="mail.template">
            <field name="name">CRM: Draft Opportunity Notification</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="subject">Follow-up Required: ${object.name}</field>
            <field name="email_from">${(object.user_id.email_formatted or user.email_formatted or '') | safe}</field>
            <field name="email_to">${object.team_id.member_emails or ''}</field>
            <field name="lang">${object.partner_id.lang or object.user_id.lang or 'fr_FR'}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Hello,</p>
                    <p>Please follow up on this opportunity
                        <a href="${object.get_base_url()}/web#id=${object.id}&amp;model=crm.lead&amp;view_type=form"
                           style="color: #007bff; text-decoration: none;">
                            ${object.name}
                        </a>.
                    </p>
                    <p>Best regards.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
