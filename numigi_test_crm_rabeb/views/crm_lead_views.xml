<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_inherit_revenue_security" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.revenue.security</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h2[@class='o_row no-gutters align-items-end']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_case_tree_view_oppor_inherit_revenue_security" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.inherit.revenue.security</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>

            <xpath expr="//field[@name='recurring_revenue_monthly']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>

            <xpath expr="//field[@name='recurring_revenue']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_case_kanban_view_leads_inherit_revenue_security" model="ir.ui.view">
        <field name="name">crm.lead.kanban.leads.inherit.revenue.security</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_kanban_record_subtitle']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>

        </field>
    </record>
</odoo>