<odoo>
    <record id="crm_team_view_form_inherit_emails" model="ir.ui.view">
        <field name="name">crm.team.form.inherit.emails</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="member_emails"
                       placeholder="Member emails will appear here automatically"
                       help="This field automatically displays all team member emails"/>
            </xpath>
        </field>
    </record>
</odoo>
