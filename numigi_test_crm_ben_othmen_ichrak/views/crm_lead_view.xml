<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="crm_lead_test_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit.test</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <field name="expected_revenue" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </field>

            <div id="probability" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </div>
        </field>
    </record>

    <record id="crm_lead_test_view_tree" model="ir.ui.view">
        <field name="name">crm.lead.view.tree.inherit.test</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <field name="expected_revenue" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </field>
        </field>
    </record>

    <record id="crm_lead_test_view_kanban" model="ir.ui.view">
        <field name="name">crm.lead.view.kanban.inherit.test</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
              <xpath expr="//t[@t-if='record.expected_revenue.raw_value']/field[@name='expected_revenue']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
                </xpath>
        <xpath expr="//progressbar[@field='activity_state']" position="attributes">
            <attribute name="sum_field" groups="sales_team.group_sale_manager">expected_revenue</attribute>
        </xpath>
             <xpath expr="//progressbar[@field='activity_state']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
        </xpath>

        </field>
    </record>

</odoo>
