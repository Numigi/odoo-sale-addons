<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kanban_view_crm_leads_inherited" model="ir.ui.view">
        <field name="name">crm.leads.inherited.kanban</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/templates/t/div/div[hasclass('oe_kanban_content')]/div[hasclass('o_kanban_record_subtitle')]"
                   position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>
            <xpath expr="//progressbar" position="attributes">
                <attribute name="sum_field"/>
            </xpath>
        </field>
    </record>

    <record id="kanban_view_add_sum_fields_for_sales_manager_group" model="ir.ui.view">
        <field name="name">crm.leads.inherited.kanban</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="numigi_test_crm_ELSAILI.kanban_view_crm_leads_inherited"/>
        <field name="groups_id" eval="[(4,ref('sales_team.group_sale_manager'))]"/>
        <field name="arch" type="xml">
            <xpath expr="//progressbar" position="attributes">
                <attribute name="sum_field">expected_revenue</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_crm_case_tree_view_oppor_tree_inherited" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_form_inherited" model="ir.ui.view">
        <field name="name">crm.lead.view.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h2/div[1]" position="attributes">
                <attribute name="groups">sales_team.group_sale_manager</attribute>
            </xpath>
        </field>
    </record>
</odoo>
