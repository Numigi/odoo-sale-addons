<?xml version="1.0" ?>

<odoo>
    <data noupdate="1">
        <record id="opportunities_reminder_sales_team" model="base.automation">
            <field name="name">Draft opportunities: Reminder sales team</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="template_id" ref="numigi_test_crm_ELSAILI.email_template_reminder_for_draft_opportunities"/>
            <field name="state">email</field>
            <field name="trigger">on_time</field>
            <field name="active" eval="True"/>
            <field name="filter_domain">
                [["stage_id", "=", 1],["type", "=", "opportunity"]]
            </field>
            <field name="trg_date_id" ref="crm.field_crm_lead__create_date"/>
            <field name="trg_date_range">10</field>
            <field name="trg_date_range_type">day</field>
        </record>
    </data>
</odoo>
