<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Mail template are declared in a NOUPDATE block
         so users can freely customize/delete them -->
    <data noupdate="1">
        <!--Email template -->
        <record id="email_template_reminder_for_draft_opportunities" model="mail.template">
            <field name="name">Opportunities: Reminder sales team</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="email_to">${object.team_id.emails | safe}</field>
            <field name="subject">Reminder for opportunity (${object.name | safe})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,<br/>
                        Thank you for following up on this opportunity
                        <a t-attf-href="'/web#id=' + str(object.id) + '&amp;model=crm.lead&amp;view_type=form'">
                            ${object.name | safe}
                        </a> .<br/>
                        Best regards.<br/>
                    </p>
                </div>
            </field>
            <field name="lang">${object.company_id.lang}</field>
        </record>
    </data>
</odoo>
