<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <!-- Technical Support Team -->
        <record id="crm_team_support_tech" model="crm.team">
            <field name="name">Technical Support Team</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Sales team -->
        <record id="sales_crm_team" model="crm.team">
            <field name="name">Sales team</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- SAV team -->
        <record id="SAV_crm_team" model="crm.team">
            <field name="name">SAV team </field>
            <field name="use_opportunities">True</field>
            <field name="alias_contact">partners</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
